# Names only. Values live in Vercel env / .env.local, never in git.
# If any of the three quote vars is absent, the form renders and a submit shows
# "email not configured, call us" (never a silent success).
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
# Preview environment ONLY. Renders labelled "PHOTO: <intent>" blocks for null photo slots.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=
